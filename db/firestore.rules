rules_version = '2';

// ADR-0008 y AGENTS.md regla 7: el navegador nunca lee ni escribe Firestore.
// Todo acceso pasa por el servidor con el Admin SDK, que no está sujeto a estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
