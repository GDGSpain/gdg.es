{
  "firestore": [
    {
      "database": "gdg-es",
      "rules": "db/firestore.rules",
      "indexes": "db/firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "db/storage.rules"
  },
  "apphosting": {
    "backendId": "gdg-es-web",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "legacy",
      ".env*",
      "firebase-debug.log",
      "firestore-debug.log",
      "ui-debug.log",
      "coverage",
      "playwright-report",
      "test-results",
      ".firebase"
    ]
  },
  "hosting": {
    "public": "hosting",
    "ignore": ["firebase.json", "**/.*", "README.md"],
    "redirects": [
      {
        "regex": "^/(.*)$",
        "destination": "https://gdg-es-web--gdg-es-develop.europe-west4.hosted.app/:1",
        "type": 302
      }
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
