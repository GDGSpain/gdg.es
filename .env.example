# Copiar a .env.local y rellenar. Validado al arrancar por src/shared/config/config.ts. Nunca se sube.

# Firebase (servidor, Admin SDK): cuenta de servicio del proyecto
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase (navegador, solo Auth): config pública de la app web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=   # restringida por referrer, solo Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=    # Map ID (necesario para Advanced Markers)
GOOGLE_GEOCODING_API_KEY=          # servidor, solo Geocoding API

# Sincronización
SYNC_USER_AGENT=GDG.es-directory (contacto: tu-email)
SYNC_SECRET=                       # protege el endpoint que dispara Cloud Scheduler

# Administración
ADMIN_EMAILS=                      # emails que reciben el custom claim admin

# Emuladores en local (vaciar en producción)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
